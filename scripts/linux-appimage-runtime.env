# StudyVis-owned AppImage type-2 runtime build tuple.
#
# Direct runtime dependencies are downloaded from the immutable tuples in
# linux-appimage-runtime-sources.tsv.  The final link is deliberately limited
# to musl, zlib, decompression-only zstd, libfuse and squashfuse.  In
# particular, mimalloc is not linked: the upstream MI_OVERRIDE=OFF build did
# not contribute any allocator code to the runtime.
STUDYVIS_APPIMAGE_RUNTIME_BUILD_REVISION=1
STUDYVIS_APPIMAGE_RUNTIME_COMMIT=75849dce7cc37e4319b633df1f116ca895c71a12
STUDYVIS_APPIMAGE_RUNTIME_VERSION=studyvis-75849dce-source-closed
STUDYVIS_APPIMAGE_RUNTIME_SOURCE_DATE_EPOCH=1782256868

# The source-built release runtime is produced only with this Jammy
# compiler/linker tuple.  gcc-11 supplies musl's compiler and the explicit CRT
# inputs; clang-14 drives the final BFD static-PIE link.  The builder records
# and hashes the exact selected CRT/libgcc files and proves from the link map
# whether any libgcc archive member was selected.
STUDYVIS_APPIMAGE_RUNTIME_CLANG_PACKAGE=clang-14
STUDYVIS_APPIMAGE_RUNTIME_CLANG_VERSION=1:14.0.0-1ubuntu1.1
STUDYVIS_APPIMAGE_RUNTIME_CLANG_SOURCE=llvm-toolchain-14
STUDYVIS_APPIMAGE_RUNTIME_CLANG_SOURCE_VERSION=1:14.0.0-1ubuntu1.1
STUDYVIS_APPIMAGE_RUNTIME_GCC_PACKAGE=gcc-11
STUDYVIS_APPIMAGE_RUNTIME_GCC_VERSION=11.4.0-1ubuntu1~22.04.3
STUDYVIS_APPIMAGE_RUNTIME_GCC_SOURCE=gcc-11
STUDYVIS_APPIMAGE_RUNTIME_GCC_SOURCE_VERSION=11.4.0-1ubuntu1~22.04.3
STUDYVIS_APPIMAGE_RUNTIME_LIBGCC_PACKAGE=libgcc-11-dev
STUDYVIS_APPIMAGE_RUNTIME_LIBGCC_VERSION=11.4.0-1ubuntu1~22.04.3
STUDYVIS_APPIMAGE_RUNTIME_BINUTILS_PACKAGE=binutils
STUDYVIS_APPIMAGE_RUNTIME_BINUTILS_VERSION=2.38-4ubuntu2.12
STUDYVIS_APPIMAGE_RUNTIME_BINUTILS_SOURCE=binutils
STUDYVIS_APPIMAGE_RUNTIME_BINUTILS_SOURCE_VERSION=2.38-4ubuntu2.12

