# Tauri CLI 2.9.5 otherwise downloads these moving release/master URLs and
# executes them during AppImage construction. Pre-populate a private cache and
# verify every byte before Tauri starts.
STUDYVIS_LINUXDEPLOY_TOOLSET_REVISION=3
STUDYVIS_APPRUN_URL=https://github.com/tauri-apps/binary-releases/releases/download/apprun-old/AppRun-x86_64
STUDYVIS_APPRUN_SHA256=f30140a43a0a59e46db21bdefdf749b9e9f2c6946e92afabbacf98b8ae73fb4f
STUDYVIS_APPRUN_BUILD_ID=84fe6e2b121f245ed5b8c05ccafe2dc1d45a9f37
STUDYVIS_APPRUN_SOURCE_COMMIT=2b8f5b39c41d3895e6b6b88a45b1905f4ffce4ef
STUDYVIS_APPRUN_SOURCE_URL=https://codeload.github.com/AppImage/AppImageKit/tar.gz/2b8f5b39c41d3895e6b6b88a45b1905f4ffce4ef
STUDYVIS_APPRUN_SOURCE_SHA256=deaee0c6db0ef958d02fdde11b46bc611129b4cd7b50dd4079e7a595af2dd460
STUDYVIS_APPRUN_SOURCE_FILE_SHA256=79c8a946886f7966f8b3a54bb7e8f81c46828625552db7b33a8d6d28a03e4268
STUDYVIS_LINUXDEPLOY_URL=https://github.com/tauri-apps/binary-releases/releases/download/linuxdeploy/linuxdeploy-x86_64.AppImage
STUDYVIS_LINUXDEPLOY_SHA256=e762bea85c8eb0d4b3508d46e5c1f037f717d0f9303ae3b4aafc8b04991fa1ef
STUDYVIS_LINUXDEPLOY_COMMIT=659c9db374666be3f29432316a859221eac28e53
STUDYVIS_LINUXDEPLOY_SOURCE_URL=https://codeload.github.com/linuxdeploy/linuxdeploy/tar.gz/659c9db374666be3f29432316a859221eac28e53
STUDYVIS_LINUXDEPLOY_SOURCE_SHA256=a8db0e406c11aeeb186f97550d0a590d98ac0c76b40858667a66a962f86347e5
# I116 — this one URL is a ROLLING tag. Upstream publishes only `continuous`
# and rebuilds it on a schedule, so the asset is replaced with no source change
# and this pin goes stale on its own. It did on 2026-09-01: the plugin's own CI
# re-ran against an unchanged tree and re-squashed the AppImage, which is enough
# to move the outer container's bytes. `linuxdeploy` and `AppRun` above do not
# have this problem — they come from tauri-apps/binary-releases under fixed
# tags — and tauri-apps does not mirror this plugin.
#
# When it next goes stale, do NOT simply paste in the hash the download
# produced. Re-establish that the SOURCE is what this file already claims, then
# re-pin. On 2026-09-11 that meant checking three things, all of which held:
#   1. `..._COMMIT` is still the upstream HEAD, so the plugin source did not
#      move (the repo's last push is that commit);
#   2. the tarball at `..._SOURCE_URL` still hashes to `..._SOURCE_SHA256`;
#   3. the appimagetool this plugin BUNDLES is still the recorded
#      STUDYVIS_APPIMAGETOOL_COMMIT. That one matters and is easy to miss: the
#      plugin's `ci/build-bundle.sh` fetches appimagetool from its own rolling
#      `continuous` tag at build time, so a rebuild can silently swap it and
#      leave the corresponding-source delivery describing a binary we no longer
#      ship. Read it out of the artifact rather than assuming: split the
#      squashfs off the AppImage at the end of its ELF headers, `unsquashfs` it,
#      and the git version is a plain string in
#      `appimagetool-prefix/usr/bin/appimagetool`.
#
# STUDYVIS_LINUXDEPLOY_TOOLSET_REVISION deliberately did NOT move for this:
# every source tuple this file delivers is byte-identical to r3, and relabelling
# unchanged corresponding source would make the archive say something untrue.
STUDYVIS_APPIMAGE_PLUGIN_URL=https://github.com/linuxdeploy/linuxdeploy-plugin-appimage/releases/download/continuous/linuxdeploy-plugin-appimage-x86_64.AppImage
STUDYVIS_APPIMAGE_PLUGIN_SHA256=0441769ab38009504d2678c38cd7e526955388dd30a215b4a20afaa5471652f2
