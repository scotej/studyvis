+static GstCaps *
+_codec_capabilities_for_unlinked_sender (GstWebRTCBin * webrtc,
+    GstWebRTCRTPTransceiver * trans, GstCaps * caps)
+{
+  GstWebRTCBinPad *pad;
+  guint i;
+
+  if (!caps || trans->kind == GST_WEBRTC_KIND_UNKNOWN
+      || WEBRTC_TRANSCEIVER (trans)->mline_locked)
+    return caps;
+  pad = _find_pad_for_transceiver (webrtc, GST_PAD_SINK, trans);
+  if (pad) {
+    gst_object_unref (pad);
+    return caps;
+  }
+
+  /* StudyVis #349: an unlinked sender's provisional payload allocation is
+   * not a codec capability. Keep the offered payload while intersecting
+   * encoding, clock rate, channel and format constraints. */
+  caps = gst_caps_make_writable (caps);
+  for (i = 0; i < gst_caps_get_size (caps); i++)
+    gst_structure_remove_field (gst_caps_get_structure (caps, i), "payload");
+  return caps;
 }
 
