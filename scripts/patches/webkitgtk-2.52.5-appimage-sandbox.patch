+static bool sdpMessageBundlesMID(const GstSDPMessage* message, const char* mid)
+{
+    if (!mid)
+        return false;
+    for (unsigned i = 0; i < gst_sdp_message_attributes_len(message); ++i) {
+        const auto attribute = gst_sdp_message_get_attribute(message, i);
+        if (StringView::fromLatin1(attribute->key) != "group"_s)
+            continue;
+        auto group = String::fromUTF8(attribute->value).split(' ');
+        if (group.isEmpty() || group[0] != "BUNDLE"_s)
+            continue;
+        for (unsigned j = 1; j < group.size(); ++j) {
+            if (group[j] == StringView::fromLatin1(mid))
+                return true;
+        }
+    }
+    return false;
+}
