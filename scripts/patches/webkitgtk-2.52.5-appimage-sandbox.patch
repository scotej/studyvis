+        auto kind = StringView::fromLatin1(gst_sdp_media_get_media(media));
+        if (!gst_sdp_media_get_port(media) || (kind != "audio"_s && kind != "video"_s))
+            continue;
+        RTPHeaderExtensionMapping mediaMapping;
+        for (unsigned j = 0; j < gst_sdp_message_attributes_len(answer); ++j)
+            collectMapping(gst_sdp_message_get_attribute(answer, j), mediaMapping);
+        for (unsigned j = 0; j < gst_sdp_media_attributes_len(media); ++j)
+            collectMapping(gst_sdp_media_get_attribute(media, j), mediaMapping);
+        if (auto mid = gst_sdp_media_get_attribute_val(media, "mid"))
