+static CString packagedInjectedBundleDirectory()
+{
+    // Keep the injected bundle in the same relocatable AppImage runtime as
+    // the subprocesses. Native packages still use PKGLIBDIR below.
+    CString executablePath = FileSystem::currentExecutablePath();
+    if (executablePath.isNull())
+        return { };
+    GUniquePtr<char> executableDirectory(g_path_get_dirname(executablePath.data()));
+    GUniquePtr<char> bundleDirectory(g_build_filename(executableDirectory.get(), "studyvis-webkit-runtime", "injected-bundle", nullptr));
+    GUniquePtr<char> bundlePath(g_build_filename(bundleDirectory.get(), INJECTED_BUNDLE_FILENAME, nullptr));
+    if (g_file_test(bundlePath.get(), G_FILE_TEST_IS_REGULAR))
+        return bundleDirectory.get();
+    return { };
+}
+
 static const char* injectedBundleDirectory()
 {
+    static NeverDestroyed<CString> packagedDirectory = packagedInjectedBundleDirectory();
+    if (!packagedDirectory.get().isNull())
+        return packagedDirectory.get().data();
+
     const char* bundleDirectory = g_getenv("WEBKIT_INJECTED_BUNDLE_PATH");
