+static String packagedWebKitProcess(const char* processName)
+{
+    // AppImages are not chroots. Resolve the subprocesses in a stable
+    // directory beside the application executable before trying the native
+    // installation prefix compiled into WebKit.
+    CString executablePath = FileSystem::currentExecutablePath();
+    if (executablePath.isNull())
+        return { };
+    GUniquePtr<char> executableDirectory(g_path_get_dirname(executablePath.data()));
+    GUniquePtr<char> processPath(g_build_filename(executableDirectory.get(), "studyvis-webkit-runtime", processName, nullptr));
+    if (g_file_test(processPath.get(), G_FILE_TEST_IS_EXECUTABLE))
+        return FileSystem::stringFromFileSystemRepresentation(processPath.get());
+    return { };
+}
