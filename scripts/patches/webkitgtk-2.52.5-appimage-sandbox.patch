+static CString packagedSandboxHelper(const char* name, const char* fallback)
+{
+    // AppImages are not chroots, so WebKit's normal /usr/bin paths refer to
+    // the host. Prefer a helper shipped beside the StudyVis executable and
+    // keep the configured path as the native-package/development fallback.
+    CString executable = FileSystem::currentExecutablePath();
+    if (!executable.isNull()) {
+        GUniquePtr<char> directory(g_path_get_dirname(executable.data()));
+        GUniquePtr<char> candidate(g_build_filename(directory.get(), name, nullptr));
+        if (g_file_test(candidate.get(), G_FILE_TEST_IS_EXECUTABLE))
+            return candidate.get();
+    }
+    return fallback;
+}
+
+const CString& bubblewrapExecutable()
+{
+    static NeverDestroyed<CString> executable = packagedSandboxHelper("bwrap", BWRAP_EXECUTABLE);
+    return executable;
+}
+
+const CString& dbusProxyExecutable()
+{
+    static NeverDestroyed<CString> executable = packagedSandboxHelper("xdg-dbus-proxy", DBUS_PROXY_EXECUTABLE);
+    return executable;
+}
