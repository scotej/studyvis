+static gboolean
+_description_keeps_candidate_owner (GstWebRTCSessionDescription * desc,
+    const IceCandidateItem * item)
+{
+  const GstSDPMedia *media;
+  gchar *ufrag = NULL, *pwd = NULL;
+  gboolean keep;
+  if (!desc || item->mlineindex >= gst_sdp_message_medias_len (desc->sdp))
+    return FALSE;
+  media = gst_sdp_message_get_media (desc->sdp, item->mlineindex);
+  if (g_strcmp0 (gst_sdp_media_get_attribute_val (media, "mid"), item->remote_mid))
+    return FALSE;
+  if (gst_sdp_media_get_port (media) == 0 && !_media_is_bundle_only (media))
+    return FALSE;
+  _get_ice_credentials_from_sdp_media (desc->sdp, item->mlineindex, &ufrag, &pwd);
+  keep = g_strcmp0 (ufrag, item->remote_ufrag) == 0 &&
+      g_strcmp0 (pwd, item->remote_pwd) == 0;
+  g_free (ufrag);
+  g_free (pwd);
+  return keep;
+}
