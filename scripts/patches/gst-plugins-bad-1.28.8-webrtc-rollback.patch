+static gboolean
+_current_pair_rejects_candidate_owner (GstWebRTCBin * webrtc,
+    const IceCandidateItem * item)
+{
+  GstSDPMessage *local, *remote;
+  const GstSDPMedia *lm, *rm;
+  GStrv lb = NULL, rb = NULL;
+  gboolean bundle, rejected;
+  if (!webrtc->current_local_description || !webrtc->current_remote_description ||
+      !_description_keeps_candidate_owner (webrtc->current_remote_description, item))
+    return FALSE;
+  local = webrtc->current_local_description->sdp;
+  remote = webrtc->current_remote_description->sdp;
+  if (item->mlineindex >= gst_sdp_message_medias_len (local) ||
+      item->mlineindex >= gst_sdp_message_medias_len (remote))
+    return FALSE;
+  lm = gst_sdp_message_get_media (local, item->mlineindex);
+  rm = gst_sdp_message_get_media (remote, item->mlineindex);
+  if (g_strcmp0 (item->remote_mid, gst_sdp_media_get_attribute_val (lm, "mid")) ||
+      g_strcmp0 (item->remote_mid, gst_sdp_media_get_attribute_val (rm, "mid")))
+    return FALSE;
+  if (gst_sdp_media_get_port (lm) != 0 && gst_sdp_media_get_port (rm) != 0)
+    return FALSE;
+  bundle = _parse_bundle (local, &lb, NULL) &&
+      _parse_bundle (remote, &rb, NULL) && lb && rb &&
+      g_strcmp0 (lb[0], rb[0]) == 0 &&
+      _bundle_has_mid (lb, item->remote_mid) &&
+      _bundle_has_mid (rb, item->remote_mid);
+  rejected = (gst_sdp_media_get_port (lm) == 0 &&
+      !(bundle && _media_is_bundle_only (lm))) ||
+      (gst_sdp_media_get_port (rm) == 0 &&
+      !(bundle && _media_is_bundle_only (rm)));
+  g_strfreev (lb);
+  g_strfreev (rb);
+  return rejected;
+}
