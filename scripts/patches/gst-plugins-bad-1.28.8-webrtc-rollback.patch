+static gchar *
+_get_committed_msid_from_media (const GstSDPMedia * media)
+{
+  guint i;
+
+  /* Media-level MSID is the stream identity. Legacy SSRC attributes may
+   * still contain a CNAME from an offer made before its sender pad existed. */
+  for (i = 0; i < gst_sdp_media_attributes_len (media); i++) {
