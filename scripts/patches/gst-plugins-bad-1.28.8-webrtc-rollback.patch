+/* The action supplies an index and candidate string, not an explicit MID.
+ * Capture the effective remote SDP owner once. An advertised ufrag must match
+ * before binding; ownerless future candidates wait for a matching description. */
+static gboolean
+_capture_remote_candidate_owner (GstWebRTCBin * webrtc,
+    IceCandidateItem * item, gboolean current_only)
+{
+  const GstSDPMessage *choices[2] = { NULL, NULL };
+  gchar *candidate_ufrag;
+  guint n;
+  if (item->remote_mid)
+    return TRUE;
+  if (!current_only && webrtc->pending_remote_description)
+    choices[0] = webrtc->pending_remote_description->sdp;
+  if (webrtc->current_remote_description)
+    choices[current_only ? 0 : 1] = webrtc->current_remote_description->sdp;
+  candidate_ufrag = _candidate_ufrag (item->candidate);
+  for (n = 0; n < G_N_ELEMENTS (choices); n++) {
+    const GstSDPMedia *media;
+    const gchar *mid;
+    gchar *ufrag = NULL, *pwd = NULL;
+    if (!choices[n] || item->mlineindex >= gst_sdp_message_medias_len (choices[n]))
+      continue;
+    media = gst_sdp_message_get_media (choices[n], item->mlineindex);
+    mid = gst_sdp_media_get_attribute_val (media, "mid");
+    if (!mid)
+      continue;
+    _get_ice_credentials_from_sdp_media (choices[n], item->mlineindex, &ufrag, &pwd);
+    if (!ufrag || !pwd || (candidate_ufrag && g_strcmp0 (candidate_ufrag, ufrag))) {
+      g_free (ufrag);
+      g_free (pwd);
+      continue;
+    }
+    item->remote_mid = g_strdup (mid);
+    item->remote_ufrag = ufrag;
+    item->remote_pwd = pwd;
+    g_free (candidate_ufrag);
+    return TRUE;
+  }
+  g_free (candidate_ufrag);
+  return FALSE;
+}
