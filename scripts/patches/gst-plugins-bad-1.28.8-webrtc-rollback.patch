+  owners = g_object_get_data (G_OBJECT (webrtc), "gst-webrtcbin-configured-ice-owners");
+  owner = owners ? g_hash_table_lookup (owners,
+      GUINT_TO_POINTER (stream ? stream->stream_id + 1 : 0)) : NULL;
+  if (!stream || !owner || owner->stream != stream)
+    goto out;
