+                webrtc->current_remote_description, item) &&
+            !_description_keeps_candidate_owner (
+                webrtc->pending_remote_description, item)) ||
+            _current_pair_rejects_candidate_owner (webrtc, item))) {
+      g_array_remove_index (webrtc->priv->pending_remote_ice_candidates, i);
+    } else {
+      i++;
+    }
+  }
+  ICE_UNLOCK (webrtc);
 }
 
