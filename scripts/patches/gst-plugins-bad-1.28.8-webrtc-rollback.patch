+  _get_ice_credentials_from_sdp_media (remote, route, &ruf, &rpwd);
+  ready = luf && lpwd && ruf && rpwd &&
+      g_strcmp0 (luf, owner->local_ufrag) == 0 &&
+      g_strcmp0 (lpwd, owner->local_pwd) == 0 &&
+      g_strcmp0 (ruf, owner->remote_ufrag) == 0 &&
+      g_strcmp0 (rpwd, owner->remote_pwd) == 0;
