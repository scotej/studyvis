+  g_strfreev (local_bundle);
+  g_strfreev (remote_bundle);
+  g_free (luf);
+  g_free (lpwd);
+  g_free (ruf);
+  g_free (rpwd);
+  g_free (section_uf);
+  g_free (section_pwd);
+  return ready;
+}
