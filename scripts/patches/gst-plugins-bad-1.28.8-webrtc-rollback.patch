+/* I125: gathered candidates belong to a physical native stream and an
+ * installed local credential generation. Keep that ownership with the bin
+ * so renegotiated SDP can advertise only candidates still valid for it. */
+typedef struct
+{
+  gchar *candidate;
+  gchar *mid;
+  gchar *ufrag;
+  gchar *pwd;
+} CachedLocalIceCandidate;
+
+typedef struct
+{
+  guint session;
+  GstWebRTCICEStream *stream;
+  gchar *local_ufrag;
+  gchar *local_pwd;
+  GPtrArray *candidates;
+} LocalIceCandidateCache;
+
+static void
+_cached_local_ice_candidate_free (CachedLocalIceCandidate * candidate)
+{
+  g_free (candidate->candidate);
+  g_free (candidate->mid);
+  g_free (candidate->ufrag);
+  g_free (candidate->pwd);
+  g_free (candidate);
+}
+
+static void
+_local_ice_candidate_cache_free (LocalIceCandidateCache * cache)
+{
+  gst_object_unref (cache->stream);
+  g_free (cache->local_ufrag);
+  g_free (cache->local_pwd);
+  g_ptr_array_unref (cache->candidates);
+  g_free (cache);
+}
+
+static LocalIceCandidateCache *
+_local_ice_candidate_cache (GstWebRTCBin * webrtc, guint session,
+    GstWebRTCICEStream * stream, gboolean create)
+{
+  GHashTable *caches = g_object_get_data (G_OBJECT (webrtc),
+      "webrtcbin-local-candidate-cache");
+  LocalIceCandidateCache *cache;
+
+  if (!stream)
+    return NULL;
+  if (!caches) {
+    if (!create)
+      return NULL;
+    caches = g_hash_table_new_full (g_direct_hash, g_direct_equal, NULL,
+        (GDestroyNotify) _local_ice_candidate_cache_free);
+    g_object_set_data_full (G_OBJECT (webrtc),
+        "webrtcbin-local-candidate-cache", caches,
+        (GDestroyNotify) g_hash_table_unref);
+  }
+  cache = g_hash_table_lookup (caches, GUINT_TO_POINTER (session + 1));
+  if (!cache || cache->stream != stream) {
+    if (!create)
+      return NULL;
+    cache = g_new0 (LocalIceCandidateCache, 1);
+    cache->session = session;
+    cache->stream = gst_object_ref (stream);
+    cache->candidates = g_ptr_array_new_with_free_func (
+        (GDestroyNotify) _cached_local_ice_candidate_free);
+    g_hash_table_replace (caches, GUINT_TO_POINTER (session + 1), cache);
+  }
+  return cache;
+}
+
+static void
+_record_local_candidate_credentials (GstWebRTCBin * webrtc, guint session,
+    GstWebRTCICEStream * stream, const gchar * ufrag, const gchar * pwd)
+{
+  LocalIceCandidateCache *cache =
+      _local_ice_candidate_cache (webrtc, session, stream, TRUE);
+
+  if (!cache)
+    return;
+  g_free (cache->local_ufrag);
+  g_free (cache->local_pwd);
+  cache->local_ufrag = g_strdup (ufrag);
+  cache->local_pwd = g_strdup (pwd);
+}
+
+static GPtrArray *
+_local_candidate_tokens (const gchar * candidate)
+{
+  GPtrArray *tokens = g_ptr_array_new_with_free_func (g_free);
+  GStrv parts = g_strsplit_set (candidate, " \t", -1);
+  guint i;
+
+  for (i = 0; parts[i]; i++)
+    if (parts[i][0])
+      g_ptr_array_add (tokens, g_strdup (parts[i]));
+  g_strfreev (parts);
+  return tokens;
+}
+
+static const gchar *
+_local_candidate_extension (GPtrArray * tokens, const gchar * key)
+{
+  guint i;
+
+  for (i = 8; i + 1 < tokens->len; i += 2)
+    if (!g_strcmp0 (g_ptr_array_index (tokens, i), key))
+      return g_ptr_array_index (tokens, i + 1);
+  return NULL;
+}
+
+static gboolean
+_local_candidate_matches_stats (GPtrArray * tokens,
+    GstWebRTCICECandidateStats * stats, const gchar * ufrag)
+{
+  const gchar *foundation, *tcp_type, *stats_ufrag;
+  const gchar *port_token, *priority_token;
+  gchar *end;
+  guint64 port, priority;
+
+  if (tokens->len < 8 || g_strcmp0 (g_ptr_array_index (tokens, 1), "1") ||
+      g_strcmp0 (g_ptr_array_index (tokens, 6), "typ"))
+    return FALSE;
+  foundation = g_ptr_array_index (tokens, 0);
+  if (!g_str_has_prefix (foundation, "candidate:"))
+    return FALSE;
+  foundation += strlen ("candidate:");
+  port_token = g_ptr_array_index (tokens, 5);
+  priority_token = g_ptr_array_index (tokens, 3);
+  port = g_ascii_strtoull (port_token, &end, 10);
+  if (!*port_token || *end)
+    return FALSE;
+  priority = g_ascii_strtoull (priority_token, &end, 10);
+  if (!*priority_token || *end ||
+      !GST_WEBRTC_ICE_CANDIDATE_STATS_PROTOCOL (stats))
+    return FALSE;
+  stats_ufrag = GST_WEBRTC_ICE_CANDIDATE_STATS_USERNAME_FRAGMENT (stats);
+  if (g_strcmp0 (foundation, GST_WEBRTC_ICE_CANDIDATE_STATS_FOUNDATION (stats)) ||
+      g_strcmp0 (g_ptr_array_index (tokens, 4),
+          GST_WEBRTC_ICE_CANDIDATE_STATS_ADDRESS (stats)) ||
+      port != GST_WEBRTC_ICE_CANDIDATE_STATS_PORT (stats) ||
+      priority != GST_WEBRTC_ICE_CANDIDATE_STATS_PRIORITY (stats) ||
+      g_ascii_strcasecmp (g_ptr_array_index (tokens, 2),
+          GST_WEBRTC_ICE_CANDIDATE_STATS_PROTOCOL (stats)) ||
+      g_strcmp0 (g_ptr_array_index (tokens, 7),
+          GST_WEBRTC_ICE_CANDIDATE_STATS_TYPE (stats)) ||
+      (stats_ufrag && g_strcmp0 (stats_ufrag, ufrag)))
+    return FALSE;
+  tcp_type = _local_candidate_extension (tokens, "tcptype");
+  switch (GST_WEBRTC_ICE_CANDIDATE_STATS_TCP_TYPE (stats)) {
+    case GST_WEBRTC_ICE_TCP_CANDIDATE_TYPE_NONE:
+      return tcp_type == NULL;
+    case GST_WEBRTC_ICE_TCP_CANDIDATE_TYPE_ACTIVE:
+      return !g_strcmp0 (tcp_type, "active");
+    case GST_WEBRTC_ICE_TCP_CANDIDATE_TYPE_PASSIVE:
+      return !g_strcmp0 (tcp_type, "passive");
+    case GST_WEBRTC_ICE_TCP_CANDIDATE_TYPE_SO:
+      return !g_strcmp0 (tcp_type, "so");
+    default:
+      return FALSE;
+  }
+}
+
+static gboolean
+_cached_local_candidate_is_live (GstWebRTCBin * webrtc,
+    LocalIceCandidateCache * cache, CachedLocalIceCandidate * candidate,
+    const gchar * ufrag, GstWebRTCICECandidateStats ** stats)
+{
+  GPtrArray *tokens = _local_candidate_tokens (candidate->candidate);
+  const gchar *candidate_ufrag = _local_candidate_extension (tokens, "ufrag");
+  gboolean live = FALSE;
+  guint i;
+
+  if (tokens->len < 8 ||
+      (candidate_ufrag && g_strcmp0 (candidate_ufrag, ufrag)))
+    goto out;
+  if (GST_WEBRTC_ICE_GET_CLASS (webrtc->priv->ice)->get_local_candidates) {
+    for (i = 0; stats && stats[i]; i++)
+      if (_local_candidate_matches_stats (tokens, stats[i], ufrag)) {
+        live = TRUE;
+        break;
+      }
+  } else {
+    /* The pinned Rice stream gathers once and keeps its physical sockets
+     * across credential changes. Other opaque backends cannot prove that. */
+    live = !candidate_ufrag &&
+        !g_strcmp0 (G_OBJECT_TYPE_NAME (cache->stream), "WebKitGstIceStream");
+  }
+out:
+  g_ptr_array_unref (tokens);
+  return live;
+}
+
+static void
+_cache_local_ice_candidate (GstWebRTCBin * webrtc, guint session,
+    const gchar * candidate)
+{
+  GstWebRTCSessionDescription *descriptions[] = {
+    webrtc->pending_local_description, webrtc->current_local_description
+  };
+  GstWebRTCICEStream *stream = _find_ice_stream_for_session (webrtc, session);
+  LocalIceCandidateCache *cache =
+      _local_ice_candidate_cache (webrtc, session, stream, FALSE);
+  GPtrArray *tokens;
+  const gchar *candidate_ufrag;
+  guint i, j;
+
+  if (!cache || !candidate || !g_str_has_prefix (candidate, "candidate:"))
+    return;
+  tokens = _local_candidate_tokens (candidate);
+  candidate_ufrag = _local_candidate_extension (tokens, "ufrag");
+  for (i = 0; i < G_N_ELEMENTS (descriptions); i++) {
+    GstWebRTCSessionDescription *description = descriptions[i];
+    const GstSDPMedia *media;
+    const gchar *mid;
+    gchar *ufrag = NULL, *pwd = NULL;
+    CachedLocalIceCandidate *stored = NULL;
+
+    if (!description || session >= gst_sdp_message_medias_len (description->sdp))
+      continue;
+    media = gst_sdp_message_get_media (description->sdp, session);
+    mid = gst_sdp_media_get_attribute_val (media, "mid");
+    _get_ice_credentials_from_sdp_media (description->sdp, session, &ufrag, &pwd);
+    if (!mid || !ufrag || !pwd ||
+        g_strcmp0 (ufrag, cache->local_ufrag) ||
+        g_strcmp0 (pwd, cache->local_pwd) ||
+        (candidate_ufrag && g_strcmp0 (candidate_ufrag, ufrag))) {
+      g_free (ufrag);
+      g_free (pwd);
+      continue;
+    }
+    for (j = 0; j < cache->candidates->len; j++) {
+      CachedLocalIceCandidate *entry = g_ptr_array_index (cache->candidates, j);
+      if (!g_strcmp0 (entry->candidate, candidate)) {
+        stored = entry;
+        break;
+      }
+    }
+    if (!stored) {
+      stored = g_new0 (CachedLocalIceCandidate, 1);
+      stored->candidate = g_strdup (candidate);
+      g_ptr_array_add (cache->candidates, stored);
+    }
+    g_free (stored->mid);
+    g_free (stored->ufrag);
+    g_free (stored->pwd);
+    stored->mid = g_strdup (mid);
+    stored->ufrag = ufrag;
+    stored->pwd = pwd;
+    break;
+  }
+  g_ptr_array_unref (tokens);
+}
+
+static void
+_merge_cached_local_ice_candidates (GstWebRTCBin * webrtc,
+    GstWebRTCSessionDescription * description)
+{
+  GStrv bundled = NULL, remote_bundle = NULL;
+  GstWebRTCSessionDescription *remote =
+      webrtc->current_remote_description;
+  guint bundle_idx = 0, i;
+
+  if (!description)
+    return;
+  if (!_parse_bundle (description->sdp, &bundled, NULL) ||
+      (bundled && !_get_bundle_index (description->sdp, bundled, &bundle_idx)))
+    goto out;
+  if (description == webrtc->pending_local_description &&
+      webrtc->pending_remote_description)
+    remote = webrtc->pending_remote_description;
+  if (remote && !_parse_bundle (remote->sdp, &remote_bundle, NULL))
+    goto out;
+  for (i = 0; i < gst_sdp_message_medias_len (description->sdp); i++) {
+    const GstSDPMedia *media = gst_sdp_message_get_media (description->sdp, i);
+    const gchar *mid = gst_sdp_media_get_attribute_val (media, "mid");
+    GstWebRTCICEStream *stream;
+    LocalIceCandidateCache *cache;
+    GstWebRTCICECandidateStats **stats = NULL;
+    gchar *ufrag = NULL, *pwd = NULL;
+    guint j;
+    gboolean accepted_bundle = mid && bundled && remote_bundle &&
+        !g_strcmp0 (bundled[0], remote_bundle[0]) &&
+        g_strv_contains ((const gchar * const *) bundled, mid) &&
+        g_strv_contains ((const gchar * const *) remote_bundle, mid);
+
+    if (!mid || !gst_sdp_media_get_port (media) ||
+        (accepted_bundle && i != bundle_idx))
+      continue;
+    stream = _find_ice_stream_for_session (webrtc, i);
+    cache = _local_ice_candidate_cache (webrtc, i, stream, FALSE);
+    if (!cache)
+      continue;
+    _get_ice_credentials_from_sdp_media (description->sdp, i, &ufrag, &pwd);
+    if (!ufrag || !pwd || g_strcmp0 (ufrag, cache->local_ufrag) ||
+        g_strcmp0 (pwd, cache->local_pwd))
+      goto next;
+    if (GST_WEBRTC_ICE_GET_CLASS (webrtc->priv->ice)->get_local_candidates)
+      stats = gst_webrtc_ice_get_local_candidates (webrtc->priv->ice, stream);
+    for (j = 0; j < cache->candidates->len;) {
+      CachedLocalIceCandidate *entry = g_ptr_array_index (cache->candidates, j);
+      guint attribute;
+      gboolean present = FALSE;
+
+      if (!_cached_local_candidate_is_live (webrtc, cache, entry, ufrag, stats)) {
+        g_ptr_array_remove_index (cache->candidates, j);
+        continue;
+      }
+      for (attribute = 0; attribute < gst_sdp_media_attributes_len (media);
+          attribute++) {
+        const GstSDPAttribute *value = gst_sdp_media_get_attribute (media, attribute);
+        if (!g_strcmp0 (value->key, "candidate") &&
+            !g_strcmp0 (value->value, entry->candidate + strlen ("candidate:"))) {
+          present = TRUE;
+          break;
+        }
+      }
+      if (!present)
+        _add_ice_candidate_to_sdp (webrtc, description->sdp, i, entry->candidate);
+      j++;
+    }
+next:
+    if (stats) {
+      for (j = 0; stats[j]; j++)
+        gst_webrtc_ice_candidate_stats_free (stats[j]);
+      g_free (stats);
+    }
+    g_free (ufrag);
+    g_free (pwd);
+  }
+out:
+  g_strfreev (bundled);
+  g_strfreev (remote_bundle);
+}
