+static gchar *
+_candidate_ufrag (const gchar *candidate)
+{
+  gchar **parts;
+  gchar *ufrag = NULL;
+  guint i;
+  if (!candidate)
+    return NULL;
+  parts = g_strsplit_set (candidate, " \t\r\n", -1);
+  for (i = 0; parts[i]; i++) {
+    if (g_str_equal (parts[i], "ufrag") && parts[i + 1] && parts[i + 1][0]) {
+      ufrag = g_strdup (parts[i + 1]);
+      break;
+    }
+  }
+  g_strfreev (parts);
+  return ufrag;
+}
