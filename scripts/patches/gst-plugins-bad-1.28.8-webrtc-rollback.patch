+/* I125: a previous current description can coexist with provisional keys on
+ * the same native stream. Only accepted backend setters update this record;
+ * candidates wait until it matches their committed SDP owner. The per-bin
+ * table owns stream references and is destroyed with the bin. */
+typedef struct {
+  GstWebRTCICEStream *stream;
+  gchar *local_ufrag, *local_pwd, *remote_ufrag, *remote_pwd;
+} ConfiguredIceOwner;
+
+static void
+_free_configured_ice_owner (ConfiguredIceOwner * owner)
+{
+  gst_object_unref (owner->stream);
+  g_free (owner->local_ufrag);
+  g_free (owner->local_pwd);
+  g_free (owner->remote_ufrag);
+  g_free (owner->remote_pwd);
+  g_free (owner);
+}
+
+static void
+_record_configured_ice_owner (GstWebRTCBin * webrtc,
+    GstWebRTCICEStream * stream, gboolean local, const gchar *ufrag,
+    const gchar *pwd)
+{
+  GHashTable *owners = g_object_get_data (G_OBJECT (webrtc),
+      "gst-webrtcbin-configured-ice-owners");
+  ConfiguredIceOwner *owner;
+  if (!owners) {
+    owners = g_hash_table_new_full (g_direct_hash, g_direct_equal, NULL,
+        (GDestroyNotify) _free_configured_ice_owner);
+    g_object_set_data_full (G_OBJECT (webrtc), "gst-webrtcbin-configured-ice-owners",
+        owners, (GDestroyNotify) g_hash_table_unref);
+  }
+  owner = g_hash_table_lookup (owners, GUINT_TO_POINTER (stream->stream_id + 1));
+  if (!owner || owner->stream != stream) {
+    owner = g_new0 (ConfiguredIceOwner, 1);
+    owner->stream = gst_object_ref (stream);
+    g_hash_table_replace (owners, GUINT_TO_POINTER (stream->stream_id + 1), owner);
+  }
+  if (local) {
+    g_free (owner->local_ufrag);
+    g_free (owner->local_pwd);
+    owner->local_ufrag = g_strdup (ufrag);
+    owner->local_pwd = g_strdup (pwd);
+  } else {
+    g_free (owner->remote_ufrag);
+    g_free (owner->remote_pwd);
+    owner->remote_ufrag = g_strdup (ufrag);
+    owner->remote_pwd = g_strdup (pwd);
+  }
+}
