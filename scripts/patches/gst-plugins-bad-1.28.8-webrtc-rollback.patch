+    gchar **parts;
+    const gchar *stream_id = NULL;
+    guint tokens = 0, j;
+
+    if (g_strcmp0 (attr->key, "msid") != 0 || !attr->value)
+      continue;
+
+    parts = g_strsplit_set (attr->value, " \t", -1);
+    for (j = 0; parts[j]; j++) {
+      if (!parts[j][0])
+        continue;
+      if (!tokens)
+        stream_id = parts[j];
+      tokens++;
+    }
+    if (tokens == 1 || tokens == 2) {
+      gchar *msid = g_strcmp0 (stream_id, "-") == 0 ? NULL :
+          g_strdup (stream_id);
+      g_strfreev (parts);
+      return msid;
+    }
+    g_strfreev (parts);
+  }
+
+  return _get_msid_from_media (media);
 }
 
