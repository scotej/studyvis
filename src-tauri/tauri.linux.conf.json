        "files": {
          "/usr/share/licenses/studyvis-runtime/APPIMAGEKIT-MIT.txt": "target/appimage-webkit/notices/APPIMAGEKIT-MIT.txt",
          "/usr/lib/libwebkit2gtk-4.1.so.0": "target/appimage-webkit/libraries/libwebkit2gtk-4.1.so.0",
