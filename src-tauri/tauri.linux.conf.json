          "/usr/share/licenses/studyvis-webkit-runtime/BUILD-MANIFEST.txt": "target/appimage-webkit/licenses/BUILD-MANIFEST.txt",
          "/usr/share/licenses/studyvis-webkit-runtime/COPYING.LIB": "target/appimage-webkit/licenses/COPYING.LIB",
          "/usr/share/licenses/studyvis-webkit-runtime/LICENSE-APPLE": "target/appimage-webkit/licenses/LICENSE-APPLE",
