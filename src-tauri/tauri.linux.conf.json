          "/usr/lib/librice-io.so.0": "target/appimage-webkit/libraries/librice-io.so.0",
          "/usr/bin/studyvis-webkit-runtime/WebKitNetworkProcess": "target/appimage-webkit/processes/WebKitNetworkProcess",
          "/usr/bin/studyvis-webkit-runtime/WebKitWebProcess": "target/appimage-webkit/processes/WebKitWebProcess",
          "/usr/bin/studyvis-webkit-runtime/WebKitGPUProcess": "target/appimage-webkit/processes/WebKitGPUProcess",
          "/usr/bin/studyvis-webkit-runtime/injected-bundle/libwebkit2gtkinjectedbundle.so": "target/appimage-webkit/processes/injected-bundle/libwebkit2gtkinjectedbundle.so",
